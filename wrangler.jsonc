// Root-level Worker configuration. Deployable via "Deploy to Cloudflare" and `wrangler deploy`.
// No resource IDs are required: the AI binding and the SQLite-backed Durable Object are
// provisioned automatically by the deploy flow. Do not remove the "migrations" block after
// first deployment: SQLite-backed Durable Object classes have a stable ID.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proj1",
  "main": "index.js",
  "compatibility_date": "2026-11-04",

  // Static assets: the ONLY asset directory is ./public and it contains ONLY browser.js.
  // run_worker_first: true sends every request through the Worker so it can attach
  // security headers uniformly and keep all API routing in one place.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Workers AI binding (server-side use only).
  "ai": {
    "binding": "AI"
  },

  "vars": {
    "OPERATOR_PASSWORD": "1234"
  },

  // Durable Object for run coordination + SQLite persistence.
  "durable_objects": {
    "bindings": [
      { "name": "RUN_COORDINATOR", "class_name": "RunCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RunCoordinator"] }
  ],


  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  },
}
