{
  "name": "memdoor-team-solve",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "memdoor team-solve role workflow as a Cloudflare Workers browser app (vanilla JS, Durable Object + SQLite, SSE).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json",
