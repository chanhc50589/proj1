    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251022.0",
    "@types/node": "24.5.2",
    "typescript": "5.9.2",
    "wrangler": "4.42.0"
  }
}